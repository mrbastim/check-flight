# Telegram bot token. Leave empty to run without Telegram notifications.
TELEGRAM_BOT_TOKEN=

# Airport provider.
PROVIDER=svo

# Storage backend. Supported values: sqlite, sqlite3, postgres, postgresql, pgx.
DB_DRIVER=postgres

# SQLite path, or PostgreSQL connection URL when DB_DRIVER=postgres.
DATABASE_URL=postgres://check_flight:change_me@postgres:5432/check_flight?sslmode=disable

# PostgreSQL container settings.
POSTGRES_DB=check_flight
POSTGRES_USER=check_flight
POSTGRES_PASSWORD=change_me